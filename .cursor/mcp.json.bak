{
  "mcpServers": {
    "braindrain": {
      "command": "/home/ettienne/Dev-sync/braindrain/config/braindrain",
      "args": [],
      "env": {},
      "type": "stdio",
      "serverName": "braindrain"
    },
    "mattermost": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-mattermost"
      ],
      "env": {
        "endpoint": "${MATTERMOST_ENDPOINT}",
        "token": "${MATTERMOST_TOKEN}",
        "team": "${MATTERMOST_TEAM}"
      },
      "type": "stdio",
      "serverName": "mattermost"
    }
  }
}
